Pandoc
  Meta
    { unMeta =
        fromList
          [ ( "bibliography"
            , MetaList [ MetaInlines [ Str "references.bib" ] ]
            )
          , ( "link-citations" , MetaBool False )
          , ( "title"
            , MetaInlines
                [ Str "Additional-citation-options"
                , Space
                , Str "Example"
                ]
            )
          ]
    }
  [ Header 2 ( "heading" , [] , [] ) [ Str "Heading" ]
  , Para
      [ Str "This"
      , Space
      , Str "filter"
      , Space
      , Str "adds"
      , Space
      , Str "additional"
      , Space
      , Str "options"
      , Space
      , Str "to"
      , Space
      , Str "citations."
      ]
  , Para
      [ Str "Here"
      , Space
      , Str "are"
      , Space
      , Str "the"
      , Space
      , Str "options"
      , Space
      , Str "provided"
      , Space
      , Str "by"
      , Space
      , Str "Quarto/Pandoc:"
      ]
  , BulletList
      [ [ Plain
            [ Str "Narrative"
            , Space
            , Str "Citation:"
            , Space
            , Cite
                [ Citation
                    { citationId = "bergelson_1996"
                    , citationPrefix = []
                    , citationSuffix = []
                    , citationMode = AuthorInText
                    , citationNoteNum = 1
                    , citationHash = 0
                    }
                ]
                [ Str "Bergelson" , Space , Str "(1996)" ]
            ]
        ]
      , [ Plain
            [ Str "Suppress"
            , Space
            , Str "Author:"
            , Space
            , Cite
                [ Citation
                    { citationId = "bergelson_1996"
                    , citationPrefix = []
                    , citationSuffix = []
                    , citationMode = SuppressAuthor
                    , citationNoteNum = 2
                    , citationHash = 0
                    }
                ]
                [ Str "(1996)" ]
            ]
        ]
      , [ Plain
            [ Str "Add"
            , Space
            , Str "Locator:"
            , Space
            , Cite
                [ Citation
                    { citationId = "bergelson_1996"
                    , citationPrefix = []
                    , citationSuffix =
                        [ Str "Section" , Space , Str "1" ]
                    , citationMode = AuthorInText
                    , citationNoteNum = 3
                    , citationHash = 0
                    }
                ]
                [ Str "Bergelson"
                , Space
                , Str "(1996,"
                , Space
                , Str "sec."
                , Space
                , Str "1)"
                ]
            ]
        ]
      , [ Plain
            [ Str "Parenthesised"
            , Space
            , Str "Citation:"
            , Space
            , Cite
                [ Citation
                    { citationId = "bergelson_1996"
                    , citationPrefix = []
                    , citationSuffix = []
                    , citationMode = NormalCitation
                    , citationNoteNum = 4
                    , citationHash = 0
                    }
                ]
                [ Str "(Bergelson" , Space , Str "1996)" ]
            ]
        ]
      , [ Plain
            [ Str "Parenthesised"
            , Space
            , Str "Citation"
            , Space
            , Str "with"
            , Space
            , Str "Locator:"
            , Space
            , Cite
                [ Citation
                    { citationId = "bergelson_1996"
                    , citationPrefix = []
                    , citationSuffix =
                        [ Str ","
                        , Space
                        , Str "Section"
                        , Space
                        , Str "1"
                        ]
                    , citationMode = NormalCitation
                    , citationNoteNum = 5
                    , citationHash = 0
                    }
                ]
                [ Str "(Bergelson"
                , Space
                , Str "1996,"
                , Space
                , Str "sec."
                , Space
                , Str "1)"
                ]
            ]
        ]
      ]
  , Para
      [ Str "Here"
      , Space
      , Str "are"
      , Space
      , Str "the"
      , Space
      , Str "expanded"
      , Space
      , Str "options:"
      ]
  , BulletList
      [ [ Plain
            [ Str "Remove"
            , Space
            , Str "Parentheses"
            , Space
            , Str "(Author"
            , Space
            , Str "Only):"
            , Space
            , Span
                ( "" , [ "remove-paren" ] , [] )
                [ Cite
                    [ Citation
                        { citationId = "bergelson_1996"
                        , citationPrefix = []
                        , citationSuffix = []
                        , citationMode = AuthorInText
                        , citationNoteNum = 6
                        , citationHash = 0
                        }
                    ]
                    [ Str "Bergelson" , Space ]
                ]
            ]
        ]
      , [ Plain
            [ Str "No"
            , Space
            , Str "Parentheses:"
            , Space
            , Span
                ( "" , [ "no-paren" ] , [] )
                [ Cite
                    [ Citation
                        { citationId = "bergelson_1996"
                        , citationPrefix = []
                        , citationSuffix = []
                        , citationMode = AuthorInText
                        , citationNoteNum = 7
                        , citationHash = 0
                        }
                    ]
                    [ Str "Bergelson" , Space , Str "1996" ]
                ]
            ]
        ]
      ]
  , Para
      [ Str "The"
      , Space
      , Str "default"
      , Space
      , Str "options"
      , Space
      , Str "can"
      , Space
      , Str "be"
      , Space
      , Str "mixed"
      , Space
      , Str "and"
      , Space
      , Str "matched"
      , Space
      , Str "with"
      , Space
      , Str "the"
      , Space
      , Str "expanded"
      , Space
      , Str "options."
      ]
  , Para
      [ Str "Below"
      , Space
      , Str "is"
      , Space
      , Str "an"
      , Space
      , Str "example"
      , Space
      , Str "in"
      , Space
      , Str "using"
      , Space
      , Str ".no-paren:"
      ]
  , Div
      ( "def-Density" , [ "theorem" , "definition" ] , [] )
      [ Para
          [ Span
              ( "" , [ "theorem-title" ] , [] )
              [ Strong
                  [ Str "Definition"
                  , Space
                  , Str "1"
                  , Space
                  , Str "("
                  , Span
                      ( "" , [ "no-paren" ] , [] )
                      [ Cite
                          [ Citation
                              { citationId = "bergelson_1996"
                              , citationPrefix = []
                              , citationSuffix =
                                  [ Str ","
                                  , Space
                                  , Str "Section"
                                  , Space
                                  , Str "1"
                                  ]
                              , citationMode = NormalCitation
                              , citationNoteNum = 8
                              , citationHash = 0
                              }
                          ]
                          [ Str "Bergelson"
                          , Space
                          , Str "1996,"
                          , Space
                          , Str "sec."
                          , Space
                          , Str "1"
                          ]
                      ]
                  , Str ")"
                  ]
              ]
          , Space
          , Str "We"
          , Space
          , Str "call"
          , Space
          , Str "define"
          , Space
          , Emph
              [ Str "density"
              , Space
              , Str "of"
              , Space
              , Str "a"
              , Space
              , Str "subset"
              , Space
              , Math InlineMath "A\\subseteq G"
              , Space
              , Str "with"
              , Space
              , Str "respect"
              , Space
              , Str "to"
              , Space
              , Str "a"
              , Space
              , Str "F\248lner"
              , Space
              , Str "sequence,"
              , Space
              , Math InlineMath "\\Phi"
              , Str ","
              ]
          , Space
          , Str "as"
          , SoftBreak
          , Math
              DisplayMath
              "d_\\Phi(A)=\\lim_{N\\rightarrow\\infty}\\frac{|\\Phi_N\\cap A|}{|\\Phi_N|},"
          , SoftBreak
          , Str "if"
          , Space
          , Str "it"
          , Space
          , Str "exists."
          ]
      ]
  , Div
      ( "refs"
      , [ "references" , "csl-bib-body" , "hanging-indent" ]
      , [ ( "entry-spacing" , "0" ) ]
      )
      [ Div
          ( "ref-bergelson_1996" , [ "csl-entry" ] , [] )
          [ Para
              [ Str "Bergelson,"
              , Space
              , Str "V."
              , Space
              , Str "1996."
              , Space
              , Span
                  ( "" , [] , [] )
                  [ Str "\8220"
                  , Str "Ergodic"
                  , Space
                  , Str "Ramsey"
                  , Space
                  , Str "Theory"
                  , Space
                  , Str "-"
                  , Space
                  , Str "an"
                  , Space
                  , Str "Update"
                  , Str "."
                  , Str "\8221"
                  ]
              , Space
              , Str "In"
              , Space
              , Emph
                  [ Str "Ergodic"
                  , Space
                  , Str "Theory"
                  , Space
                  , Str "and"
                  , Space
                  , Str "Zd"
                  , Space
                  , Str "Actions"
                  ]
              , Str ","
              , Space
              , Str "edited"
              , Space
              , Str "by"
              , Space
              , Str "Mark"
              , Space
              , Str "Pollicott"
              , Space
              , Str "and"
              , Space
              , Str "KlausEditors"
              , Space
              , Str "Schmidt,"
              , Space
              , Str "1\8211\&62."
              , Space
              , Str "London"
              , Space
              , Str "Mathematical"
              , Space
              , Str "Society"
              , Space
              , Str "Lecture"
              , Space
              , Str "Note"
              , Space
              , Str "Series."
              , Space
              , Str "Cambridge"
              , Space
              , Str "University"
              , Space
              , Str "Press."
              , Space
              , Link
                  ( "" , [] , [] )
                  [ Str "https://doi.org/10.1017/CBO9780511662812.002" ]
                  ( "https://doi.org/10.1017/CBO9780511662812.002"
                  , ""
                  )
              , Str "."
              ]
          ]
      ]
  ]
